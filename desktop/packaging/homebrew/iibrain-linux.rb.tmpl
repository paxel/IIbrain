class Iibrain < Formula
  desc "Private second brain of plain Markdown files"
  homepage "https://github.com/paxel/IIbrain"
  version "{{VERSION}}"
  license any_of: ["Apache-2.0", "MIT"]

  depends_on :linux

  on_arm do
    url "https://github.com/paxel/IIbrain/releases/download/v#{version}/iibrain-#{version}-linux-arm64.tar.gz"
    sha256 "{{SHA_LINUX_ARM64}}"
  end
  on_intel do
    url "https://github.com/paxel/IIbrain/releases/download/v#{version}/iibrain-#{version}-linux-x86_64.tar.gz"
    sha256 "{{SHA_LINUX_X86_64}}"
  end

  def install
    libexec.install Dir["*"]
    bin.install_symlink libexec/"iibrain"

    # An absolute Exec: a desktop session does not read Homebrew's shell environment,
    # so its bin directory is not on the session's PATH. The icon stays a theme name,
    # "iibrain": the install step below puts the PNG into ~/.local/share/icons, where
    # every desktop looks.
    inreplace libexec/"io.github.paxel.iibrain.desktop" do |entry|
      entry.gsub! "Exec=iibrain", "Exec=#{opt_bin}/iibrain"
    end

    # The helper and everything it copies live together, so it finds the icon next to
    # itself. A wrapper rather than a symlink, for the same reason.
    (libexec/"install-icon.sh").chmod 0755
    (bin/"iibrain-install-icon").write <<~SH
      #!/bin/sh
      exec "#{opt_libexec}/install-icon.sh" "$@"
    SH
    (bin/"iibrain-install-icon").chmod 0755

    # Also in Homebrew's own share, for the sessions that do read it.
    (share/"applications").mkpath
    cp libexec/"io.github.paxel.iibrain.desktop", share/"applications/io.github.paxel.iibrain.desktop"
    (share/"icons/hicolor/256x256/apps").mkpath
    cp libexec/"icon_256.png", share/"icons/hicolor/256x256/apps/iibrain.png"
  end

  # Homebrew's own share directory is not on a desktop session's XDG_DATA_DIRS, so the
  # entry above alone stays invisible to menus: the app could not be started at all.
  # This step puts the launcher entry and the icon into ~/.local/share, which every
  # session reads. Declared steps replace the post_install method since Homebrew 7.0.
  # A home that cannot be written (a container, a bottle build, a post-install
  # sandbox) must not fail the install over a menu entry.
  post_install_steps do
    run "install-icon.sh", base: :libexec, must_succeed: false
  end

  def caveats
    <<~EOS
      IIbrain is in your application menu; start it again if it was open.
      Another user of this machine gets the entry with: iibrain-install-icon
    EOS
  end

  test do
    assert_predicate bin/"iibrain", :executable?
  end
end
