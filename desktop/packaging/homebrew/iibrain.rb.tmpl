cask "iibrain" do
  version "{{VERSION}}"

  arch arm: "arm64", intel: "x86_64"
  sha256 arm:   "{{SHA_MACOS_ARM64}}",
         intel: "{{SHA_MACOS_X86_64}}"

  url "https://github.com/paxel/IIbrain/releases/download/v#{version}/iibrain-#{version}-macos-#{arch}.dmg"
  name "IIbrain"
  desc "Private second brain of plain Markdown files"
  homepage "https://github.com/paxel/IIbrain"

  app "IIbrain.app"
  binary "#{appdir}/IIbrain.app/Contents/MacOS/iibrain"

  caveats <<~EOS
    The app is not signed with an Apple Developer certificate. On first
    launch macOS refuses it: open System Settings, Privacy & Security, and
    choose Open Anyway.
  EOS
end
